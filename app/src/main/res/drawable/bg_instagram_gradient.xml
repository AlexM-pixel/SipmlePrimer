<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
      angle="45" - градиент идет по диагонали (снизу слева -> вправо вверх)
      startColor - Желто-оранжевый
      centerColor - Фирменный розовый
      endColor - Глубокий фиолетовый
    -->
    <gradient
        android:angle="45"
        android:startColor="#F6C888"
        android:centerColor="#F37CA4"
        android:endColor="#F10BCB"
        android:type="linear" />
</shape>