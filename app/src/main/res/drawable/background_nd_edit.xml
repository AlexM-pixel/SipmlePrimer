<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Фокус -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFFFFF"/>
            <stroke
                android:width="3dp"
                android:color="@color/stroke_nd_edit"/> <!-- зеленая рамка -->
            <corners android:radius="16dp"/>
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="12dp"
                android:bottom="12dp"/>
        </shape>
    </item>

    <!-- Обычное состояние -->
    <item>
        <shape>
            <solid android:color="#ECFEF8"/>
            <stroke
                android:width="2dp"
                android:color="@color/stroke_nd_edit"/>
            <corners android:radius="16dp"/>
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="12dp"
                android:bottom="12dp"/>
        </shape>
    </item>

</selector>