<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Когда выбрана -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/itemSelectBg" />
            <stroke android:width="1dp" android:color="?attr/BottomSheet_stroke_color" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Обычное состояние -->
    <item>
        <shape>
            <solid android:color="@color/itemUncheckBg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>