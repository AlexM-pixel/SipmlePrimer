<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/standard_margin">

    <!-- 2. НАША КРУГЛАЯ КАРТОЧКА (Центрируется внутри) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_avatar_item"
        android:layout_width="@dimen/avatr_image_size"
        android:layout_height="@dimen/avatr_image_size"
        android:layout_gravity="center"
        app:cardBackgroundColor="#F4F6F8"
        app:cardCornerRadius="48dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/stroke_nd_edit"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_avatar_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/standard_margin"
            android:src="@drawable/boy_1"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>
    <FrameLayout
        android:id="@+id/fl_check_badge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:elevation="8dp"
        android:background="@drawable/bg_circle_shape"
        android:backgroundTint="@android:color/white"
        android:padding="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/card_avatar_item"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_avatar_item">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_shape"
            android:backgroundTint="#6FCF97"
            android:padding="4dp"
            android:src="@drawable/baseline_check_24"
            app:tint="@android:color/white" />
        <!-- Замени ic_check на любую галочку из Vector Assets (например, ic_baseline_check_24) -->
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>