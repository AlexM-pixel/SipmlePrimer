<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/standard_margin"
    app:cardBackgroundColor="@android:color/white"
    app:cardPreventCornerOverlap="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/container_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Иконка в закругленном квадрате -->
        <FrameLayout
            android:id="@+id/fl_icon_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/standard_margin"
            android:background="@drawable/background_rv_nd"
            >

            <ImageView
                android:id="@+id/iv_action_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                tools:src="@drawable/ic_shop_add"
                />
        </FrameLayout>

        <!-- Заголовок -->
        <TextView
            android:id="@+id/tv_action_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/standard_margin"
            android:textAlignment="center"
            android:textColor="@color/onBoardingNDColor"
            android:textSize="@dimen/auth_textQuestion_size"
            android:textStyle="bold"
            tools:text="Добавить покупку" />

        <!-- Описание -->
        <TextView
            android:id="@+id/tv_action_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/standard_margin"
            android:lines="2"
            android:textSize="@dimen/item_text_size"
            android:textAlignment="center"
            android:textColor="@color/text_colorND"
            tools:text="Если трата не сохранилась автоматически — добавь её вручную" />

        <!-- Контейнер для нижней части (Кнопка или Стрелка) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            >

            <!-- Главная кнопка (Для центрального элемента) -->

            <!-- Стрелка (Для боковых элементов) -->
            <Button
                android:id="@+id/btn_action_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/standard_margin"
                android:backgroundTint="@color/GreenNDColor"
                android:text="+ Добавить"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp" />

            <ImageView
                android:id="@+id/iv_action_arrow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/analytics"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>