<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ЦВЕТНАЯ ПОЛОСКА СЛЕВА -->
        <View
            android:id="@+id/view_color_stripe"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="#9C27B0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ИКОНКА (Квадрат с закруглениями) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_spend_icon"
            android:layout_width="@dimen/frame_image_size"
            android:layout_height="@dimen/frame_image_size"
            android:layout_marginStart="@dimen/standard_margin"
            android:layout_marginTop="@dimen/standard_margin"
            android:layout_marginBottom="@dimen/standard_margin"
            android:background="#9C27B0"
            android:padding="@dimen/standard_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_color_stripe"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            tools:src="@drawable/enrgy_drink" />

        <!-- НАЗВАНИЕ -->
        <TextView
            android:id="@+id/tv_spend_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="@dimen/item_text_size"
            app:layout_constraintBottom_toTopOf="@+id/tv_spend_category"
            app:layout_constraintEnd_toStartOf="@+id/tv_spend_amount"
            app:layout_constraintStart_toEndOf="@+id/iv_spend_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_spend_icon"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Wildberries" />


        <TextView
            android:id="@+id/tv_spend_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawableStart="@drawable/rrow_back_ios_new_24"
            android:drawablePadding="6dp"
            android:drawableTint="#888888"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:visibility="gone"
            android:textColor="#888888"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/tv_spend_date"
            app:layout_constraintEnd_toEndOf="@+id/tv_spend_name"
            app:layout_constraintStart_toStartOf="@+id/tv_spend_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_spend_name"
            tools:text="Онлайн-покупки" />

        <!-- ДАТА (С маленькой иконкой) -->
        <TextView
            android:id="@+id/tv_spend_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawableStart="@drawable/ic_calendar_month_24"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/text_colorND"
            android:textSize="@dimen/item_text_size"
            app:layout_constraintBottom_toBottomOf="@+id/iv_spend_icon"
            app:layout_constraintEnd_toEndOf="@+id/tv_spend_name"
            app:layout_constraintStart_toStartOf="@+id/tv_spend_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_spend_category"
            tools:text="24 апреля 2026" />

        <!-- СУММА -->
        <TextView
            android:id="@+id/tv_spend_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/backgroundGreenNDColor"
            android:textSize="@dimen/title_Total_spend"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/height_progressBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_currency"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="25" />

        <!-- BYN (Уменьшенный текст) -->
        <TextView
            android:id="@+id/tv_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/standard_margin"
            android:layout_marginEnd="12dp"
            android:text="BYN"
            android:textColor="@color/backgroundGreenNDColor"
            android:textSize="@dimen/item_text_size"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_spend_amount"
            app:layout_constraintEnd_toStartOf="@+id/iv_arrow" />

        <!-- СТРЕЛКА -->
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_keyboard_arrow_right_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>