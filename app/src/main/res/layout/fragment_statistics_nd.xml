<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. ХЕДЕР (Выбор года) -->
    <LinearLayout
        android:id="@+id/layout_header_StSolo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/background_bottom_radius_nd"

        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_prev_year_StSolo"
            android:layout_width="@dimen/frame_image_size"
            android:layout_height="40dp"
            android:src="@drawable/arrow_back_ios_24"
            android:background="?selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tv_current_year_StSolo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="2026 год"
            android:textSize="@dimen/title_Text_size"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <ImageButton
            android:id="@+id/btn_next_year"
            android:layout_width="@dimen/frame_image_size"
            android:layout_height="40dp"
            android:src="@drawable/ic_keyboard_arrow_right_24dp"
            android:background="?selectableItemBackgroundBorderless"
            app:tint="@color/white"/>
    </LinearLayout>

    <!-- 2. КАРУСЕЛЬ ГРАФИКОВ (Пончик <-> Линейный) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_charts"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header_StSolo"/>
    <!-- Высота 320dp оптимальна для графика, чтобы он был читаемым -->

    <!-- 3. ИНДИКАТОР (Точки) -->
    <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
        android:id="@+id/dots_charts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:dotsColor="#E0E0E0"
        app:dotsStrokeColor="#6FCF97"
        app:dotsCornerRadius="8dp"
        app:dotsSize="10dp"
        app:dotsSpacing="6dp"
        app:layout_constraintTop_toBottomOf="@id/vp_charts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. ЗАГОЛОВОК СПИСКА -->
    <TextView
        android:id="@+id/tv_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Детализация расходов"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#555"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dots_charts"/>

    <!-- 5. СПИСОК (Снизу) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_stats_details"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_list_title"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_place_stat"/>
    <!-- item_place_stat мы делали в прошлый раз (с прогресс баром места) -->

</androidx.constraintlayout.widget.ConstraintLayout>