<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onBoardingBg"
    android:fillViewport="true"> <!-- Фон как на скрине (светло-мятный) -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/cycle_one"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/cycle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/cycle_two"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/cycle"
            app:layout_constraintBottom_toBottomOf="@+id/cycle_one"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cycle_one" />

        <View
            android:id="@+id/cycle_three"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@drawable/cycle"
            app:layout_constraintBottom_toBottomOf="@+id/cycle_one"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cycle_one" />
        <!-- КОТ (Сверху) -->
        <!-- Важно: id картинки кота должен быть правильным -->
        <ImageView
            android:id="@+id/iv_cat_top"
            android:layout_width="220dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:scaleType="fitEnd"
            android:src="@drawable/cat_setting"
            app:layout_constraintBottom_toTopOf="@+id/card_main"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <!-- ========================================== -->
        <!-- КАРТОЧКА 1: ПРОФИЛЬ И БАНКИ                -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-4dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/iv_cat_top"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- СЕКЦИЯ ПРОФИЛЯ -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_base_button">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_avatar_item"
                        android:layout_width="@dimen/frame_image_size"
                        android:layout_height="@dimen/frame_image_size"
                        android:layout_margin="@dimen/standard_margin"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="6dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="@color/stroke_nd_edit"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/iv_avatar_settings"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/height_progressBar"
                            android:scaleType="fitCenter"
                            android:src="@drawable/boy_1" />

                    </com.google.android.material.card.MaterialCardView>

                    <FrameLayout
                        android:id="@+id/fl_check_badge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_shape"
                        android:backgroundTint="@android:color/white"
                        android:elevation="8dp"
                        android:padding="3dp"
                        app:layout_constraintBottom_toBottomOf="@+id/card_avatar_item"
                        app:layout_constraintEnd_toEndOf="@+id/card_avatar_item"
                        app:layout_constraintTop_toBottomOf="@+id/card_avatar_item">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_shape"
                            android:backgroundTint="#6FCF97"
                            android:padding="4dp"
                            android:src="@drawable/edit_24"
                            app:tint="@android:color/white" />
                        <!-- Замени ic_check на любую галочку из Vector Assets (например, ic_baseline_check_24) -->
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_user_name_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cardView_margin"
                        android:layout_marginTop="@dimen/cardView_margin"
                        android:text="Привет,"
                        android:textColor="#3A6A51"
                        android:textSize="@dimen/title_Total_spend"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_greeting"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/standard_margin"
                        android:layout_marginTop="@dimen/cardView_margin"
                        android:background="@drawable/background_rv_nd"
                        android:backgroundTint="#6FCF97"
                        android:drawableEnd="@drawable/edit_24"
                        android:elevation="@dimen/standard_margin"
                        android:paddingHorizontal="@dimen/standard_margin"
                        android:paddingVertical="@dimen/height_progressBar"
                        android:text="Саня  "
                        android:textColor="@color/white"
                        android:textSize="@dimen/title_Total_spend"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@+id/tv_user_name_settings"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/tv_sleghka"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cardView_margin"
                        android:layout_marginTop="@dimen/standard_margin"
                        android:text="Я слежу за твоими расходами"
                        android:textColor="@color/onBoardingNDColor"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_greeting" />

                    <!-- Плашка с почтой -->
                    <TextView
                        android:id="@+id/tv_email_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cardView_margin"
                        android:layout_marginTop="@dimen/cardView_margin"
                        android:layout_marginBottom="@dimen/standard_margin"
                        android:background="@drawable/bg_email_pill"
                        android:drawableStart="@drawable/ic_baseline_person_24"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/color_PaletteND"
                        android:elevation="2dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp"
                        android:textColor="#555555"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_sleghka"
                        tools:text="sasha@mail.ru" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0" />

                <!-- СЕКЦИЯ БАНКОВ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Заголовок с иконкой кота -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_cat_face_small" /> <!-- Маленькая мордочка кота -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Банк"
                            android:textColor="#333333"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/standard_margin"
                        android:text="Я читаю сообщения от:"
                        android:textColor="@color/onBoardingNDColor"
                        android:textSize="16sp" />

                    <!-- ЧИПЫ (Банки) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/standard_margin"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroup_banks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/standard_margin">


                            <!-- Пример добавленных банков (в коде они будут добавляться динамически) -->
                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SBERBANK"
                                android:textColor="@android:color/white"
                                app:chipBackgroundColor="@color/colorPrimaryDarkND"
                                app:chipCornerRadius="8dp" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ALFABANK"
                                android:textColor="@android:color/white"
                                app:chipBackgroundColor="@color/colorPrimaryDarkND"
                                app:chipCornerRadius="8dp" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ALFABANK"
                                android:textColor="@android:color/white"
                                app:chipBackgroundColor="@color/colorPrimaryDarkND"
                                app:chipCornerRadius="8dp" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ALFABANK"
                                android:textColor="@android:color/white"
                                app:chipBackgroundColor="@color/colorPrimaryDarkND"
                                app:chipCornerRadius="8dp" />

                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_add_bank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="@dimen/standard_margin"
                        android:background="@drawable/background_btn_nd"
                        android:text="+ Добавить банк"
                        android:textColor="@android:color/white"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================== -->
        <!-- КАРТОЧКА 2: ОБЩИЙ БЮДЖЕТ                   -->
        <!-- ========================================== -->
        <!-- ========================================== -->
        <!-- КАРТОЧКА 2: ОБЩИЙ БЮДЖЕТ (С ИНВАЙТАМИ)     -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_budget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/card_main"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Заголовок карточки -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cat_face_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Общий бюджет"
                        android:textColor="#333333"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Делите расходы и следите за бюджетом вместе"
                    android:textColor="@color/onBoardingNDColor"
                    android:textSize="14sp" />

                <!-- ГЛАВНАЯ ПАНЕЛЬ ПАРТНЕРА (Кликабельная) -->
                <LinearLayout
                    android:id="@+id/layout_partner_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_edittext_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/iv_friend_avatar_settings"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_circle_shape"
                        android:backgroundTint="@color/green_cycle"
                        android:padding="4dp"
                        android:src="@drawable/ic_baseline_person_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_friend_name_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Нет партнера"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:id="@+id/tv_friend_email_settings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/onBoardingNDColor"
                            android:textSize="13sp"
                            tools:text="Нажмите, чтобы пригласить" />
                    </LinearLayout>

                    <!-- Иконка действия справа (+ или Крестик) -->
                    <ImageView
                        android:id="@+id/iv_friend_action_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_add_24"
                        app:tint="@color/colorPrimaryDarkND" />
                </LinearLayout>

                <!-- БЛОК ДИНАМИЧЕСКИХ КНОПОК (Ожидание, Принять, Отклонить) -->
                <LinearLayout
                    android:id="@+id/layout_partner_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <Button
                        android:id="@+id/btn_partner_negative"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Отклонить"
                        android:textColor="#FF5252" />

                    <Button
                        android:id="@+id/btn_partner_positive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#6FCF97"
                        android:text="Принять"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_themes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/card_budget">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cat_face_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Цветовая схема"
                        android:textColor="#333333"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Выберите тему вашего приложения"
                    android:textColor="@color/onBoardingNDColor"
                    android:textSize="14sp" />

                <!-- Поле ввода и кнопка в один ряд -->

                <RadioGroup
                    android:id="@+id/radio_group_styleTheme_nd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/standard_margin"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_pink_nd"
                        style="@style/RadioButtonBase"
                        android:text="pink"
                        android:textSize="@dimen/item_text_size" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_orange_nd"
                        style="@style/RadioButtonBase"
                        android:text="orange"
                        android:textSize="@dimen/item_text_size" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_blue_nd"
                        style="@style/RadioButtonBase"
                        android:text="origin"
                        android:textSize="@dimen/item_text_size" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radio_def_nd"
                        style="@style/RadioButtonBase"
                        android:text="default"
                        android:textSize="@dimen/item_text_size" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/card_themes">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cat_face_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Общая карта"
                        android:textColor="#333333"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/total_cart_switcher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/standard_margin"
                    android:paddingEnd="23dp"
                    android:paddingBottom="16dp"
                    android:text="Отображать общую карту всех расходов"
                    android:textColor="@color/onBoardingNDColor" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/onBoardingSplashBg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/standard_margin"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_cat_face_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Пуш-уведомления"
                        android:textColor="#333333"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_push"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/standard_margin"
                    android:paddingEnd="23dp"
                    android:paddingBottom="16dp"
                    android:text="показывать пуш-уведомления "
                    android:textColor="@color/onBoardingNDColor" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_switch">

            <LinearLayout
                android:id="@+id/row_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Написать в поддержку"
                    android:textColor="@color/onBoardingNDColor"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/cycle_bottom"
            android:layout_width="520dp"
            android:layout_height="520dp"
            android:background="@drawable/cycle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent" />

        <View
            android:id="@+id/cycle_botM"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:background="@drawable/cycle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/card_support">

            <Button
                android:id="@+id/btn_logout"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
