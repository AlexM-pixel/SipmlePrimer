<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#95CEAB"
    tools:context=".hw9.newDesign.ui.RegistrationFragment">

    <View
        android:id="@+id/cycle_oneLogin"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/cycle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/cycle_twoLogin"
        android:layout_width="486dp"
        android:layout_height="486dp"
        android:background="@drawable/cycle"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_oneLogin"
        app:layout_constraintEnd_toEndOf="@id/cycle_oneLogin"
        app:layout_constraintStart_toStartOf="@+id/cycle_oneLogin"
        app:layout_constraintTop_toTopOf="@+id/cycle_oneLogin" />

    <View
        android:id="@+id/cycle_threeLogin"
        android:layout_width="800dp"
        android:layout_height="800dp"
        android:background="@drawable/cycle"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_oneLogin"
        app:layout_constraintEnd_toEndOf="@id/cycle_oneLogin"
        app:layout_constraintStart_toStartOf="@+id/cycle_oneLogin"
        app:layout_constraintTop_toTopOf="@+id/cycle_oneLogin" />
    <!-- Блок выбора аватарки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="@dimen/standard_margin"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/edit_username_registration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/standard_margin"
            android:text="Выберите аватар"
            android:textColor="@color/onBoardingNDColor"
            android:textSize="@dimen/title_Text_size"
            android:textStyle="bold" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_avatar_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_avatar_carousel"
           />

    </LinearLayout>


    <EditText
        android:id="@+id/edit_mail_registration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@drawable/background_nd_edit"
        android:drawableStart="@drawable/ic_baseline_email_24"
        android:drawablePadding="12dp"
        android:elevation="18dp"
        android:hint="@string/write_mail"
        android:padding="12dp"
        android:textColor="@color/text_colorND"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_image"
        android:layout_width="wrap_content"
        android:layout_height="210dp"
        android:layout_marginTop="@dimen/item_text_size"
        android:adjustViewBounds="true"
        android:src="@drawable/cat_privet_desk"
        app:layout_constraintBottom_toTopOf="@+id/textView_query_alreadyRegistration"
        app:layout_constraintStart_toStartOf="parent"
        />
    <EditText
        android:id="@+id/edit_username_registration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@drawable/background_nd_edit"
        android:drawableStart="@drawable/ic_person_24"
        android:drawablePadding="12dp"
        android:elevation="18dp"
        android:hint="@string/write_username"
        android:padding="12dp"
        android:textColor="@color/text_colorND"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/edit_mail_registration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <EditText
        android:id="@+id/edit_passw_registration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="28dp"
        android:background="@drawable/background_nd_edit"
        android:drawableStart="@drawable/ic_baseline_vpn_key_24"
        android:drawablePadding="12dp"
        android:elevation="18dp"
        android:hint="@string/write_password"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="@color/text_colorND"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_mail_registration" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_registration"
        style="@style/Widget.AppCompat.Toolbar.Button.Navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/standard_margin"
        android:text="@string/next"
        android:elevation="20dp"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_passw_registration" />

    <ProgressBar
        android:id="@+id/progressBarRegistration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_oneLogin"
        app:layout_constraintEnd_toEndOf="@id/cycle_oneLogin"
        app:layout_constraintStart_toStartOf="@+id/cycle_oneLogin"
        app:layout_constraintTop_toTopOf="@+id/cycle_oneLogin" />

    <TextView
        android:id="@+id/textView_query_alreadyRegistration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="26dp"
        android:text="@string/text_reg_to_login"
        android:textColor="@color/colorPalette1"
        android:textSize="@dimen/auth_textQuestion_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_goTo_loginFragment"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_goTo_loginFragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/background_login_btn"
        android:text="ВОЙТИ"
        android:textColor="@color/colorPalette1"
        android:textSize="@dimen/auth_btnText_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textView_query_alreadyRegistration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textView_query_alreadyRegistration"
        app:layout_constraintTop_toTopOf="@+id/textView_query_alreadyRegistration" />
</androidx.constraintlayout.widget.ConstraintLayout>