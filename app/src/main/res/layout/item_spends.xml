<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_cardView_nd"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        >

        <FrameLayout
            android:id="@+id/home_frame_spends_nd"
            android:layout_width="@dimen/frame_image_size"
            android:layout_height="0dp"
            android:background="@drawable/background_rv_nd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/image_text_spends_nd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="И"
                android:textColor="?attr/titleColor"
                android:textSize="40sp"
                android:textStyle="bold" />
        </FrameLayout>


        <TextView
            android:id="@+id/home_title_spend_nd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/standard_margin"
            android:layout_marginStart="@dimen/cardView_margin"
            android:text="Июнь"
            android:textColor="@color/black"
            android:textSize="@dimen/month_text_size_rv"
            app:layout_constraintStart_toEndOf="@+id/home_frame_spends_nd"
            app:layout_constraintTop_toTopOf="@+id/home_frame_spends_nd" />

        <TextView
            android:id="@+id/home_date_spends_nd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2022"
            android:textColor="@color/text_colorND"
            android:textSize="@dimen/yer_text_size_rv"
            app:layout_constraintStart_toStartOf="@+id/home_title_spend_nd"
            app:layout_constraintTop_toBottomOf="@+id/home_title_spend_nd"/>

        <!-- Прогресс бар  -->
        <LinearLayout
            android:id="@+id/layout_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            android:layout_marginHorizontal="@dimen/standard_margin"
            app:layout_constraintTop_toBottomOf="@+id/strelka"
            app:layout_constraintEnd_toStartOf="@+id/strelka"
            app:layout_constraintStart_toEndOf="@+id/home_frame_spends_nd"
            >

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_horizontalBar"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:trackCornerRadius="4dp"
            android:progress="0"
            app:trackThickness="@dimen/height_progressBar"
            />

            <TextView
                android:id="@+id/text_for_progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Недостаточно данных"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_value_spends_nd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/standard_margin"
            android:text="1353.96"
            android:textStyle="bold"
            android:textColor="?attr/titleColor"
            android:textSize="@dimen/month_text_size_rv"
            app:layout_constraintBottom_toTopOf="@+id/byn_nd"
            app:layout_constraintEnd_toStartOf="@+id/strelka"
            app:layout_constraintTop_toTopOf="@+id/home_frame_spends_nd"
            app:layout_constraintVertical_chainStyle="packed"  />

        <TextView
            android:id="@+id/byn_nd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BYN"
            android:textColor="?attr/titleColor"
            android:textSize="@dimen/item_text_size"
            app:layout_constraintEnd_toEndOf="@+id/home_value_spends_nd"
            app:layout_constraintTop_toBottomOf="@+id/home_value_spends_nd" />

        <ImageView
            android:id="@+id/strelka"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_keyboard_arrow_right_24dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>