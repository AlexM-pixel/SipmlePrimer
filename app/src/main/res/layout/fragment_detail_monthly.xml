<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_rv_nd">

    <!-- ЗЕЛЕНАЯ ШАПКА ФОНА -->
    <View
        android:id="@+id/top_green_bg"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/background_bottom_radius_nd"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/cycle_one"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/cycle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/cycle_two"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/cycle"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_one"
        app:layout_constraintEnd_toEndOf="@+id/cycle_one"
        app:layout_constraintStart_toStartOf="@+id/cycle_one"
        app:layout_constraintTop_toTopOf="@+id/cycle_one" />

    <View
        android:id="@+id/cycle_three"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/cycle"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_one"
        app:layout_constraintEnd_toEndOf="@+id/cycle_one"
        app:layout_constraintStart_toStartOf="@+id/cycle_one"
        app:layout_constraintTop_toTopOf="@+id/cycle_one" />
    <!-- ХЕДЕР (Кнопка Назад и Заголовок Месяца) -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Кнопка Назад (Белая на зеленом фоне) -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="@dimen/standard_margin"
            android:background="@drawable/background_card_nd"
            android:padding="@dimen/standard_margin"
            android:src="@drawable/arrow" />

        <TextView
            android:id="@+id/tv_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="@dimen/title_Text_size"
            android:textStyle="bold"
            tools:text="Апрель 2026" />
    </LinearLayout>

    <!-- КАРТОЧКА КАТЕГОРИИ (Белая) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/cardView_margin"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/cardView_padding">


            <!-- Итоги: Сумма и Количество -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_icon_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:id="@+id/fl_icon_bg"
                        android:layout_width="@dimen/logo_image_size"
                        android:layout_height="@dimen/logo_image_size"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/detail_image_spends_nd"
                            android:layout_width="@dimen/logo_image_size"
                            android:layout_height="@dimen/logo_image_size"
                            android:layout_gravity="center"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                            android:background="@color/green_cycle"
                            tools:src="@drawable/icon_apteka_48" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_circle_shape"
                        android:backgroundTint="@android:color/white"
                        android:padding="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/fl_icon_bg"
                        app:layout_constraintBottom_toBottomOf="@+id/fl_icon_bg"
                        app:layout_constraintStart_toStartOf="@+id/fl_icon_bg"
                        app:layout_constraintEnd_toEndOf="@+id/fl_icon_bg"
                        >

                        <!-- Замени @drawable/ic_edit на свою иконку карандаша или стрелочек обновления -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_shape"
                            android:backgroundTint="@color/backgroundGreenNDColor"
                            android:padding="3dp"
                            android:src="@drawable/edit_24"
                            app:tint="@color/colorGrafik_line" />
                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <!-- Сумма -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nameSpend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/standard_margin"
                        android:textColor="@color/black"
                        android:textSize="@dimen/title_Text_size"
                        android:textStyle="bold"
                        tools:text="Аптека" />


                    <TextView
                        android:id="@+id/tv_category_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/standard_margin"
                        android:textColor="@color/backgroundGreenNDColor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="456.30 BYN" />
                </LinearLayout>

                <!-- Вертикальная линия-разделитель -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/standard_margin"
                    android:background="#E0E0E0" />

                <!-- Количество -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Покупок"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_purchases_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/backgroundGreenNDColor"
                        android:textSize="@dimen/title_Text_size"
                        android:textStyle="bold"
                        tools:text="14" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" шт."
                        android:textColor="@color/text_colorND"
                        android:textSize="@dimen/item_text_size" />
                </LinearLayout>
            </LinearLayout>

            <!-- ПРОГРЕСС БАР (Доля категории в общих тратах месяца) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pb_category_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/standard_margin"
                app:indicatorColor="@color/backgroundGreenNDColor"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp"
                tools:progress="35" />

            <TextView
                android:id="@+id/tv_category_share_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/height_progressBar"
                android:gravity="end"
                android:textColor="@color/text_colorND"
                android:textSize="12sp"
                tools:text="35% от всех трат за апрель" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- СПИСОК ПОКУПОК -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/monthly_detail_Spends_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_summary"
        tools:listitem="@layout/item_detail_byname" />

    <!-- ПЛАВАЮЩАЯ КНОПКА (Добавить) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_spend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add_24"
        app:backgroundTint="#6FCF97"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>