<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================== -->
    <!-- 1. БАЗОВАЯ ТЕМА (Зеленая / Мятная)         -->
    <!-- ========================================== -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Системные цвета -->
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">#A7AAAA</item>
        <item name="colorSurface">@color/backgroundGreenNDColor</item>

        <!-- Твои кастомные атрибуты (attrs.xml) -->
        <item name="cycle_color">@color/green_cycle</item>
        <item name="splashGradient">@color/onBoardingSplashBg</item>
        <item name="toggle_text_byn">@color/colorPaletteDef</item>
        <item name="BottomSheet_stroke_color">@color/itemStroke</item>
        <item name="itemUncheckBg_color">@color/itemUncheckBg</item>
        <item name="itemSelectedBg_color">@color/itemSelectBg</item>
        <item name="toggle_button">@drawable/toggle_button_def</item>
        <item name="header_background">@drawable/background_base_button</item>
        <item name="bottomNavBgColor">@color/backgroundGreenNDColor</item>
        <item name="cardBgColor">#6fcf97</item>
        <item name="titleColor">@color/backgroundGreenNDColor</item>
        <item name="rvND_color">#77D0F4DF</item>
        <item name="dots_color">@color/text_colorND</item>
        <item name="color_tint_icon">@color/colorPrimaryDark</item>
        <item name="color_sheet_text">@color/sheet_text</item>


        <!-- ДОБАВЛЕНЫ НЕДОСТАЮЩИЕ АТРИБУТЫ -->
        <item name="text_input_check">@color/backgroundGreenNDColor</item>
        <item name="toggle_button_bg_orange">@drawable/toggle_button_orange</item>

        <!-- Диалоги -->
        <item name="materialAlertDialogTheme">@style/MyCustomDialogTheme</item>
    </style>

    <!-- ========================================== -->
    <!-- 2. ТЕМА PINK (Розовая)                     -->
    <!-- ========================================== -->
    <!-- ========================================== -->
    <!-- 2. ТЕМА PINK (В стиле INSTAGRAM)           -->
    <!-- ========================================== -->
    <style name="AppThemePink" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Главный цвет (Яркий Magenta) -->
        <item name="colorPrimary">#E1306C</item>
        <!-- Темный цвет (Фиолетовый) -->
        <item name="colorPrimaryDark">#833AB4</item>
        <!-- Акцентный цвет (Оранжевый) -->
        <item name="colorAccent">#F56040</item>

        <!-- Цвет поверхности диалогов (оставляем белый с легким розоватым оттенком) -->
        <item name="colorSurface">#FFF0F5</item>

        <!-- Твои кастомные атрибуты -->
        <!-- Для кругов на фоне делаем полупрозрачный розовый (~24% opacity) -->
        <item name="cycle_color">#3DE1306C</item>
        <item name="bottomNavBgColor">#E1306C</item>
        <item name="cardBgColor">#F83E7D</item>
        <item name="titleColor">#F83E7D</item>
        <item name="rvND_color">#77F4D0E0</item>
        <item name="dots_color">#833AB4</item>
        <item name="itemUncheckBg_color">@color/itemUncheckBgPink</item>
        <item name="itemSelectedBg_color">@color/itemSelectBgPink</item>
        <item name="color_tint_icon">#E1306C</item>
        <item name="color_sheet_text">#D3228D</item>


        <!-- ВОТ ОН! Ставим инста-градиент на сплэш-скрин -->
        <item name="splashGradient">@drawable/bg_instagram_gradient</item>
        <item name="header_background">@drawable/splash_bg_pink</item>
        <item name="toggle_text_byn">#E1306C</item>
        <item name="BottomSheet_stroke_color">#E1306C</item>
        <item name="toggle_button">@drawable/toggle_pink</item>
        <!-- Для кнопок и переключателей -->
        <item name="text_input_check">#E1306C</item>
        <item name="toggle_button_bg_orange">@drawable/toggle_button_orange</item>
        <!-- Диалоги -->
        <item name="materialAlertDialogTheme">@style/MyCustomDialogTheme</item>
    </style>


    <!-- ========================================== -->
    <!-- 3. ТЕМА ORANGE (Оранжевая)                 -->
    <!-- ========================================== -->
    <style name="AppThemeOrange" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Системные цвета -->
        <item name="colorPrimary">#FF9800</item>
        <item name="colorPrimaryDark">#FF5722</item>
        <item name="colorAccent">#FFFF5722</item>
        <item name="colorSurface">#F3F3F1</item>

        <!-- Твои кастомные атрибуты -->
        <item name="cycle_color">@color/orange_cycle</item>
        <item name="splashGradient">@drawable/splash_bg_orange</item>
        <item name="header_background">@drawable/gradient_bg_orange</item>
        <item name="toggle_text_byn">@color/colorPaletteOrange</item>
        <item name="BottomSheet_stroke_color">@color/orange_cycle</item>
        <item name="toggle_button">@drawable/toggle_button_orange</item>
        <item name="bottomNavBgColor">@color/colorPaletteOrange</item>
        <item name="cardBgColor">@color/colorPaletteOrange</item>
        <item name="titleColor">@color/colorPaletteOrange</item>
        <item name="rvND_color">#77F4E7D0</item>
        <item name="dots_color">@color/orange_cycle</item>
        <item name="itemUncheckBg_color">@color/itemUncheckBgOrange</item>
        <item name="itemSelectedBg_color">@color/itemSelectBgOrange</item>
        <item name="color_tint_icon">#FFFF5722</item>
        <item name="color_sheet_text">#FFFF5722</item>

        <!-- ДОБАВЛЕНЫ НЕДОСТАЮЩИЕ АТРИБУТЫ -->
        <item name="text_input_check">#FF9800</item>
        <item name="toggle_button_bg_orange">@drawable/toggle_button_orange</item>
        <!-- Диалоги -->
        <item name="materialAlertDialogTheme">@style/MyCustomDialogTheme</item>
    </style>


    <!-- ========================================== -->
    <!-- 4. ТЕМА BLUE (Синяя / Origin)              -->
    <!-- ========================================== -->
    <style name="AppThemeBlue" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Системные цвета -->
        <item name="colorPrimary">#03A9F4</item>
        <item name="colorPrimaryDark">#065593</item>
        <item name="colorAccent">#03A9F4</item>
        <item name="colorSurface">#F3F3F1</item>

        <!-- Твои кастомные атрибуты -->
        <item name="cycle_color">@color/blue_cycle</item>
        <item name="splashGradient">@drawable/splash_bg_blue</item>
        <item name="header_background">@drawable/gradient_bg_blue</item>
        <item name="toggle_text_byn">@color/colorPaletteBlue</item>
        <item name="BottomSheet_stroke_color">@color/blue_cycle</item>
        <item name="toggle_button">@drawable/toggle_button_blue</item>
        <item name="bottomNavBgColor">@color/colorPaletteBlue</item>
        <item name="cardBgColor">@color/colorPaletteBlue</item>
        <item name="titleColor">@color/colorPaletteBlue</item>
        <item name="rvND_color">#77D0F4F4</item>
        <item name="dots_color">@color/colorGrafik_fon</item>
        <item name="itemUncheckBg_color">@color/itemUncheckBgBlue</item>
        <item name="itemSelectedBg_color">@color/itemSelectBgBlue</item>
        <item name="color_tint_icon">#05A0E6</item>
        <item name="color_sheet_text">#086DBC</item>

        <!-- ДОБАВЛЕНЫ НЕДОСТАЮЩИЕ АТРИБУТЫ -->
        <item name="text_input_check">#03A9F4</item>
        <item name="toggle_button_bg_orange">@drawable/toggle_button_orange</item>

        <!-- Диалоги -->
        <item name="materialAlertDialogTheme">@style/MyCustomDialogTheme</item>
    </style>


    <!-- ========================================== -->
    <!-- ДОПОЛНИТЕЛЬНЫЕ СТИЛИ (Кнопки, тексты и т.д.)-->
    <!-- ========================================== -->

    <style name="MyButtons">
        <item name="colorButtonNormal">@color/colorPaletteBlue</item>
        <item name="colorAccent">@color/colorGrafik_fon</item>
        <item name="android:elevation">8dp</item>
        <item name="android:buttonCornerRadius" tools:targetApi="p">10dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.MyDarkButton" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorButtonNormal">@color/colorAccent</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.MyTextDetail" parent="AppTheme">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fadeScrollbars">true</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">5</item>
        <item name="android:padding">4dp</item>
        <item name="android:scrollbars">vertical</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ThemeOverlay.FirebaseIcon" parent="AppTheme">
        <item name="android:layout_marginTop">@dimen/icon_top_margin</item>
        <item name="android:layout_marginBottom">@dimen/icon_bottom_margin</item>
    </style>

    <style name="ThemeOverlay.MyTitleText" parent="AppTheme">
        <item name="android:elevation">6dp</item>
        <item name="color">@color/colorGrafik_line</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">36sp</item>
    </style>

    <style name="fab_user">
        <item name="colorAccent">#FDCC39</item>
    </style>

    <style name="fab_friend">
        <item name="colorAccent">#F8B9BD47</item>
    </style>

    <style name="RadioButtonBase">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@android:color/transparent</item>
        <item name="android:textColor">@color/black_white_color_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/toggle_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:padding">2dp</item>
    </style>

    <style name="MaterialCalendarTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">#A65FB670</item>
        <item name="colorSurface">#E4FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/TextButton.Dialog1</item>
        <item name="buttonBarNegativeButtonStyle">@style/TextButton.Dialog1</item>
    </style>

    <style name="TextButton.Dialog1" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/black_white_color_selector</item>
    </style>

    <!-- ========================================== -->
    <!-- НАСТРОЙКИ КРУГЛЫХ ДИАЛОГОВ (Material 3)    -->
    <!-- ========================================== -->

    <style name="MyCustomDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- БАЗОВЫЙ ФОН: Белый -->
        <item name="colorSurface">@android:color/white</item>
        <!-- Отключаем фиолетовую примесь -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="shapeAppearance">@style/ShapeAppearance.MyApp.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/MyDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MyDialogButton.Negative</item>
    </style>

    <style name="ShapeAppearance.MyApp.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <!-- Углы диалога -->
        <item name="cornerSize">16dp</item>
    </style>

    <style name="MyDialogButton.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <!-- Кнопка "ДА" будет краситься в цвет текущей темы! -->
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="MyDialogButton.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_colorND</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="textAllCaps">false</item>
    </style>

</resources>